PORT=5000

# MongoDB Atlas — paste from Atlas → Connect → Drivers → Node.js
# Replace <password> with your Database User password (see note below)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Database name created inside your Atlas cluster
DB_NAME=taskManagerDB

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend URL(s) for CORS and password-reset links (comma-separated for multiple)
CLIENT_URL=http://localhost:5173
INCLUDE_RESET_LINK=true

# Email (password reset) — Gmail example: enable 2FA, then create App Password
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=KaamDone <your_email@gmail.com>

# Task deadline email — sent ~30 minutes before due date (server must stay running)
DEADLINE_REMINDERS_ENABLED=true
DEADLINE_REMINDER_MINUTES=30
DEADLINE_REMINDER_CHECK_MS=60000
